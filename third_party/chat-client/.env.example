# iag-chat-client is a LIBRARY, not a standalone service — it has no process and
# reads no environment of its own. Everything below is CONSUMER-SIDE reference:
# the env a service that imports this client typically sets, then feeds into
# chatclient.Options in code:
#
#   chatclient.New(chatclient.Options{
#       BaseURL:      os.Getenv("CHAT_SERVICE_URL"),
#       TokenURL:     os.Getenv("AUTH_TOKEN_URL"),
#       ClientID:     os.Getenv("SERVICE_CLIENT_ID"),
#       ClientSecret: os.Getenv("SERVICE_CLIENT_SECRET"),
#   })
#
# The client always authenticates service-to-service with audience iag.chat.

# --- chat service target ---
# Direct on the internal network, or via the gateway prefix in prod, e.g.
# https://<gateway>/api/v1/chat
CHAT_SERVICE_URL=http://chat:8085

# --- this service's S2S credentials (used to mint a token for aud=iag.chat) ---
# Reuse the consuming service's existing OAuth client — no chat-specific creds.
AUTH_TOKEN_URL=http://localhost:3001/oauth/token
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=
