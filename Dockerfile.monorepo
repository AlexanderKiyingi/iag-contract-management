# syntax=docker/dockerfile:1.7
#
# Monorepo builds from IAG_multi_backend root (deploy/docker-compose, meta CI).
#
#   docker build -f services/commercial/contract-management/Dockerfile.monorepo --target monorepo .

FROM golang:1.25-alpine AS base
RUN apk add --no-cache ca-certificates
ENV PLATFORM_GO_DEP=/deps/platform-go
ENV CHAT_CLIENT_DEP=/deps/chat-client

FROM base AS platform-go-copy
COPY shared/platform-go ${PLATFORM_GO_DEP}
COPY shared/services/chat-client ${CHAT_CLIENT_DEP}

FROM base AS build-monorepo
COPY --from=platform-go-copy ${PLATFORM_GO_DEP} ${PLATFORM_GO_DEP}
COPY --from=platform-go-copy ${CHAT_CLIENT_DEP} ${CHAT_CLIENT_DEP}
WORKDIR /src/services/commercial/contract-management
COPY services/commercial/contract-management/go.mod services/commercial/contract-management/go.sum ./
RUN go mod edit -replace=github.com/alvor-technologies/iag-platform-go=${PLATFORM_GO_DEP} \
    -replace=github.com/alvor-technologies/iag-chat-client=${CHAT_CLIENT_DEP} \
    && go mod download
COPY services/commercial/contract-management/ .
# The COPY above restored go.mod from the source tree, which still has the
# meta-repo-only relative `replace => ../../../shared/...` paths. From this
# WORKDIR those resolve to /src/shared/... (not present in the container — the
# vendored modules are at ${PLATFORM_GO_DEP} / ${CHAT_CLIENT_DEP}). Re-apply the
# replaces so `go build` finds the dependencies.
RUN set -eu; \
    go mod edit -replace=github.com/alvor-technologies/iag-platform-go=${PLATFORM_GO_DEP} \
        -replace=github.com/alvor-technologies/iag-chat-client=${CHAT_CLIENT_DEP}; \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/contract-management .; \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/jobs ./cmd/jobs

FROM alpine:3.20 AS monorepo
RUN apk add --no-cache ca-certificates tzdata wget
WORKDIR /app
COPY --from=build-monorepo /out/contract-management .
COPY --from=build-monorepo /out/jobs /app/jobs
EXPOSE 4103
ENV GIN_MODE=release \
    ENVIRONMENT=production \
    PORT=4103
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:4103/ready || exit 1
USER nobody
ENTRYPOINT ["/app/contract-management"]
